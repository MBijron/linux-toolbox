#!/bin/bash

c_choose_path() {
    local results="$1"
    local preferred_index="$2"
    local color_index=""
    local color_abbr=""
    local color_worktree_badge=""
    local color_name=""
    local color_archive_name=""
    local color_path=""
    local color_reset=""
    local count
    local chosen_path
    local selection
    local clean_results
    local active_name_color
    local ticket_metadata
    local ticket_segment
    local unused_ticket_abbreviation
    local unused_base_name
    local name_column
    local index_label
    local raw_folder_name
    local name_prefix=""
    local name_label

    if [[ -z "$results" ]]; then
        echo "No matching repository found." >&2
        return 1
    fi

    clean_results="$(printf '%s\n' "$results" | awk 'NF')"
    count="$(printf '%s\n' "$clean_results" | awk 'NF {c++} END {print c+0}')"

    if [[ "$count" -eq 0 ]]; then
        echo "No matching repository found." >&2
        return 1
    fi

    if [[ "$count" -eq 1 ]]; then
        chosen_path="$(printf '%s\n' "$clean_results" | awk -F '\t' 'NF {print $1; exit}')"
        if [[ -z "$chosen_path" ]]; then
            echo "No matching repository found." >&2
            return 1
        fi
        printf '%s\n' "$chosen_path"
        return 0
    fi

    if [[ -t 1 ]]; then
        color_index=$'\033[1;33m'
        color_abbr=$'\033[1;36m'
        color_worktree_badge=$'\033[0;33m'
        color_name=$'\033[0;37m'
        color_archive_name=$'\033[0;90m'
        color_path=$'\033[0;90m'
        color_reset=$'\033[0m'
    fi

    echo "Multiple matches found:" >&2
    local index
    local item_path
    local item_name
    local item_abbr
    local tab_after_abbr
    local tab_after_name
    local current_line
    for ((index = 0; index < count; index++)); do
        current_line="$(printf '%s\n' "$clean_results" | sed -n "$((index + 1))p")"
        IFS=$'\t' read -r item_path item_name item_abbr <<< "$current_line"
        raw_folder_name="${item_path##*/}"
        ticket_segment=""
        name_prefix=""
        name_label="$item_name"

        tab_after_abbr=$'\t'
        if ((${#item_abbr} < 8)); then
            tab_after_abbr+=$'\t'
        fi

        tab_after_name=$'\t'
        if ((${#item_name} < 24)); then
            tab_after_name+=$'\t'
        fi

        active_name_color="$color_name"
        if [[ "$item_name" == "archive" && "$item_abbr" == "_" ]]; then
            active_name_color="$color_archive_name"
        fi

        if ticket_metadata="$(c_worktree_entry_metadata "$item_path" "$raw_folder_name" 2>/dev/null)"; then
            IFS=$'\t' read -r ticket_segment unused_ticket_abbreviation unused_base_name <<< "$ticket_metadata"
            name_label="${color_worktree_badge}[w]${color_reset} ${active_name_color}${item_name}"
        fi

        index_label="$((index + 1)))"
        printf '%b%d)%b\t%b%s%b%s%b%s%b%s%b%s%b\n' \
            "$color_index" "$((index + 1))" "$color_reset" \
            "$color_abbr" "$item_abbr" "$color_reset" \
            "$tab_after_abbr" \
            "$active_name_color" "$name_label" "$color_reset" \
            "$tab_after_name" \
            "$color_path" "$item_path" "$color_reset" >&2

        if [[ -n "$ticket_segment" ]]; then
            name_column=${#index_label}
            name_column=$(( ((name_column / 8) + 1) * 8 ))
            name_column=$(( name_column + ${#item_abbr} ))
            name_column=$(( ((name_column / 8) + 1) * 8 ))
            if ((${#item_abbr} < 8)); then
                name_column=$(( ((name_column / 8) + 1) * 8 ))
            fi
            name_column=$(( name_column + 4 ))

            printf '%*s%b%s%b\n' \
                "$name_column" '' \
                "$color_path" "$ticket_segment" "$color_reset" >&2
        fi
    done

    if [[ "$preferred_index" =~ ^[0-9]+$ ]] && ((preferred_index >= 1 && preferred_index <= count)); then
        chosen_path="$(printf '%s\n' "$clean_results" | sed -n "${preferred_index}p" | awk -F '\t' '{print $1}')"
        if [[ -z "$chosen_path" ]]; then
            echo "No matching repository found." >&2
            return 1
        fi
        printf '%s\n' "$chosen_path"
        return 0
    fi

    while true; do
        printf 'Pick one (1-%d): ' "$count" >&2
        read -r selection

        if [[ "$selection" =~ ^[0-9]+$ ]] && ((selection >= 1 && selection <= count)); then
            chosen_path="$(printf '%s\n' "$clean_results" | sed -n "${selection}p" | awk -F '\t' '{print $1}')"
            if [[ -z "$chosen_path" ]]; then
                echo "No matching repository found." >&2
                return 1
            fi
            printf '%s\n' "$chosen_path"
            return 0
        fi

        echo "Invalid choice." >&2
    done
}