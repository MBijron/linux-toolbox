#!/bin/bash

startup_checks_install_zle_handler() {
    [[ -n "$ZSH_VERSION" ]] || return 0

    typeset -g __toolbox_startup_notice_path="${TMPDIR:-/tmp}/toolbox-startup-notice.$$"

    TRAPUSR2() {
        local notice_path="${__toolbox_startup_notice_path:-}"

        [[ -n "$notice_path" && -f "$notice_path" ]] || return 0

        if zle -I >/dev/null 2>&1; then
            printf '\033[A\r\033[K' > "/proc/$$/fd/2" 2>/dev/null || true
            command cat -- "$notice_path" > "/proc/$$/fd/2" 2>/dev/null || true
            printf '\n' > "/proc/$$/fd/2" 2>/dev/null || true
            command rm -f -- "$notice_path" >/dev/null 2>&1 || true
            zle reset-prompt >/dev/null 2>&1 || true
        else
            command cat -- "$notice_path" > "/proc/$$/fd/2" 2>/dev/null || true
            command rm -f -- "$notice_path" >/dev/null 2>&1 || true
        fi

        return 0
    }
}

startup_checks_publish() {
    local notice_path="$1"
    local terminal_shell_pid="$2"
    local output_target="$3"
    local temporary_notice_path="${notice_path}.new"

    if [[ -n "$notice_path" ]]; then
        umask 077
        command cat > "$temporary_notice_path" 2>/dev/null || return 0
        command mv -f -- "$temporary_notice_path" "$notice_path" >/dev/null 2>&1 || return 0
        if kill -USR2 "$terminal_shell_pid" >/dev/null 2>&1; then
            return 0
        fi
        if [[ -n "$output_target" && -e "$output_target" ]]; then
            command cat -- "$notice_path" > "$output_target" 2>/dev/null || true
        fi
        command rm -f -- "$notice_path" >/dev/null 2>&1 || true
        return 0
    fi

    if [[ -n "$output_target" && -e "$output_target" ]]; then
        command cat > "$output_target" 2>/dev/null || true
    else
        command cat >/dev/null 2>&1 || true
    fi
}

startup_checks_write_error() {
    local result_path="$1"
    local message="$2"
    local detail="${3:-}"
    local red=$'\033[0;31m'
    local reset=$'\033[0m'

    {
        printf '%b%s%b\n' "$red" "$message" "$reset"
        if [[ -n "$detail" ]]; then
            printf '%b%s%b\n' "$red" "$detail" "$reset"
        fi
    } > "$result_path" 2>/dev/null || true
}

startup_tbi_check_run() {
    local result_path="$1"
    local check_output
    local check_status
    local orange=$'\033[38;5;208m'
    local grey=$'\033[90m'
    local reset=$'\033[0m'

    command -v tbi >/dev/null 2>&1 || return 0

    check_output="$(tbi check </dev/null 2>&1)"
    check_status=$?

    case "$check_status" in
        0)
            return 0
            ;;
        # Shell exit statuses are eight-bit, so an exit code of 300 is
        # observed as 44 (300 modulo 256).
        44)
            {
                if [[ -n "$check_output" ]]; then
                    printf '%b%s%b\n' "$orange" "$check_output" "$reset"
                fi
                printf '%b%s%b\n' "$grey" 'Run tsync to pull, rebuild tbi and rebuild other tools' "$reset"
            } > "$result_path" 2>/dev/null || true
            ;;
        *)
            printf '%s\n' "Could not perform 'tbi outdated' check, make sure 'tbi check' is available" > "$result_path" 2>/dev/null || true
            ;;
    esac

    return 0
}

startup_checks_run() {
    local output_target="$1"
    local terminal_shell_pid="$2"
    local notice_path="$3"
    local temporary_dir
    local repository_result
    local tbi_result
    local repository_pid
    local tbi_pid
    local repository_status
    local tbi_status

    temporary_dir="$(mktemp -d "${TMPDIR:-/tmp}/toolbox-startup-checks.XXXXXX" 2>/dev/null)"
    if [[ -z "$temporary_dir" || ! -d "$temporary_dir" ]]; then
        printf '%s\n' 'Could not run terminal startup checks: temporary storage could not be created.' |
            startup_checks_publish "$notice_path" "$terminal_shell_pid" "$output_target"
        return 0
    fi

    repository_result="$temporary_dir/repositories"
    tbi_result="$temporary_dir/tbi"

    repository_updates_run "$repository_result" &
    repository_pid=$!
    startup_tbi_check_run "$tbi_result" &
    tbi_pid=$!

    wait "$repository_pid" >/dev/null 2>&1
    repository_status=$?
    wait "$tbi_pid" >/dev/null 2>&1
    tbi_status=$?

    if [[ "$repository_status" -ne 0 && ! -s "$repository_result" ]]; then
        startup_checks_write_error "$repository_result" "Could not update configured repositories: the background check exited with status $repository_status."
    fi
    if [[ "$tbi_status" -ne 0 && ! -s "$tbi_result" ]]; then
        printf '%s\n' "Could not perform 'tbi outdated' check, make sure 'tbi check' is available" > "$tbi_result" 2>/dev/null || true
    fi

    if [[ -s "$repository_result" || -s "$tbi_result" ]]; then
        {
            [[ -s "$repository_result" ]] && command cat -- "$repository_result"
            if [[ -s "$repository_result" && -s "$tbi_result" ]]; then
                printf '\n'
            fi
            [[ -s "$tbi_result" ]] && command cat -- "$tbi_result"
        } | startup_checks_publish "$notice_path" "$terminal_shell_pid" "$output_target"
    fi

    command rm -f -- "$repository_result" "$tbi_result" >/dev/null 2>&1 || true
    command rmdir -- "$temporary_dir" >/dev/null 2>&1 || true
    return 0
}

startup_checks_start() {
    local output_target="$1"
    local terminal_shell_pid="$$"
    local notice_path="${__toolbox_startup_notice_path:-}"

    if [[ -n "$ZSH_VERSION" ]]; then
        startup_checks_run "$output_target" "$terminal_shell_pid" "$notice_path" </dev/null >/dev/null 2>&1 &!
    else
        startup_checks_run "$output_target" "$terminal_shell_pid" "" </dev/null >/dev/null 2>&1 &
        disown $! 2>/dev/null || true
    fi

    return 0
}
