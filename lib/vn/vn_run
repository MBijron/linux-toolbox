#!/bin/bash

vn_run() {
    local command_name
    local command_path

    if [[ ! -v TB_VIRTUAL_NETWORK_LOCATION ]]; then
        printf '%s\n' \
            'To use vn, clone git@github.com:MBijron/virtual-network.git and run first-run.sh to initialize the repository.' >&2
        return 1
    fi

    if (( $# == 0 )); then
        vn_print_available_commands
        return 0
    fi

    command_name="$1"
    shift

    if [[ "$command_name" == *.* || "$command_name" == */* ]]; then
        printf 'Unknown virtual network command: %s\n' "$command_name" >&2
        return 1
    fi

    command_path="$TB_VIRTUAL_NETWORK_LOCATION/$command_name"
    if [[ ! -f "$command_path" ]]; then
        printf 'Unknown virtual network command: %s\n' "$command_name" >&2
        return 1
    fi

    "$command_path" "$@"
}
